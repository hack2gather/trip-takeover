id: cache-poisoning-port

info:
  name: Cache Poison Fuzzing
  author: Jerry1319
  severity: critical
  reference:
    - https://youst.in/posts/cache-poisoning-at-scale/
    - https://portswigger.net/web-security/web-cache-poisoning
  metadata:
    max-request: 5834
  tags: cache

http:
  - raw:
      - |
        GET /?test=1 HTTP/1.1
        Host: {{Hostname}}:1337
        User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:105.0) Gecko/20100101 Firefox/105.0
      - |
        GET /?test=1 HTTP/1.1
        Host: {{Hostname}}:1337
        User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:105.0) Gecko/20100101 Firefox/105.0

    matchers:
      - type: status
        status:
          - 403
          - 500
        condition: and
